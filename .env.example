# Supabase (projet région EU)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Serveur uniquement — jamais exposée au client
SUPABASE_SERVICE_ROLE_KEY=

# IA — Vercel AI SDK. Un modèle = « provider:model ».
# Fournisseurs supportés : anthropic, openai, google, mistral (clé requise par fournisseur utilisé).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
MISTRAL_API_KEY=

# Modèles par niveau d'usage (défauts Anthropic si absents)
LLM_MODEL=anthropic:claude-sonnet-5
LLM_MODEL_PREMIUM=anthropic:claude-opus-4-8
LLM_MODEL_LIGHT=anthropic:claude-haiku-4-5-20251001

# Overrides facultatifs par tâche (format provider:model)
LLM_TASK_CLASSIFY_INTENT=
LLM_TASK_SUMMARIZE_DOCUMENT=
LLM_TASK_SCORE_LEAD=
LLM_TASK_DETECT_ANOMALY=
LLM_TASK_DRAFT_EMAIL=
LLM_TASK_DRAFT_POST=
LLM_TASK_WEEKLY_REPORT=
LLM_TASK_IDENTITY_SYNTHESIS=
LLM_TASK_RECOMMEND_ACTION=
LLM_TASK_CAMPAIGN_BRIEF=

# OAuth connecteurs — Google Cloud Console (Sheets API activée) et notion.so/my-integrations
# Redirect URIs à déclarer : <origine>/api/connectors/google_sheets/callback et <origine>/api/connectors/notion/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NOTION_OAUTH_CLIENT_ID=
NOTION_OAUTH_CLIENT_SECRET=

# Recherche web — enrichit l'onboarding et les fiches société.
# DEUX fournisseurs derrière la même interface (lib/research/provider.ts).
# Sans aucune clé, la recherche est simplement désactivée : rien ne casse.
#
# Qui cherche : openai | perplexity. Absent = le premier dont la clé existe.
# Valeur explicite SANS sa clé = recherche désactivée (pas de repli silencieux
# sur l'autre fournisseur : on ne dépense pas chez qui vous n'avez pas choisi).
RESEARCH_PROVIDER=
# Modèle OpenAI de recherche (outil `web_search`, Responses API).
# Absent = défaut en dur dans lib/research/openai-search.ts.
# ATTENTION AU COÛT : facturé 10 $ / 1000 appels d'outil **plus** les tokens de
# contenu web au tarif du modèle — c'est cette seconde part qui domine. Un modèle
# raisonnant haut de gamme n'est pas nécessaire ici : l'agent COLLECTE des faits,
# c'est la couche LLM qui rédige. Doit rester un modèle raisonnant
# (`reasoning.effort` est figé à « low » côté code).
RESEARCH_OPENAI_MODEL=
# Clé Perplexity : https://www.perplexity.ai/settings/api (crédits prépayés).
PERPLEXITY_API_KEY=
# Profondeur (donc coût) : fast | low | medium | high | xhigh.
# Absent = profondeur par type de recherche (voir lib/research/research-rules.ts).
PERPLEXITY_PRESET=

# Secret de la route /api/cron/sync (scheduler externe). Générer comme la clé ci-dessous.
CRON_SECRET=

# Chiffrement des tokens OAuth des connecteurs (32 octets, base64)
# Générer : openssl rand -base64 32
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# Observabilité LLM — optionnelle. URL EU du cloud Langfuse :
# https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
